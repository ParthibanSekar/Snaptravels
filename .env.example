FLASK_APP=main.py
FLASK_ENV=production

# REQUIRED: Generate a strong random key before deploying
# Run: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=<replace-with-your-random-32-char-key>

DATABASE_URL=sqlite:///snaptravels.db
WTF_CSRF_ENABLED=true

# Corporate Travel Portal — Basic Auth credentials
# Used by Site24x7 Synthetic Monitors (or any Basic Auth client)
# IMPORTANT: change these from defaults before deploying
CORP_BASIC_USER=<your_corp_username>
CORP_BASIC_PASS=<your_strong_password>
