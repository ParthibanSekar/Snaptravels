        {
          "name": "Get Hotel Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Flight Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"flight\",\n  \"flight_id\": 1,\n  \"amount\": 5500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/book",
              "host": ["{{baseUrl}}"],
              "path": ["api", "book"]
            }
          }
        },
        {
          "name": "Create Hotel Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"hotel\",\n  \"hotel_id\": 1,\n  \"amount\": 8500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/book",
              "host": ["{{baseUrl}}"],
              "path": ["api", "book"]
            }
          }
        },
        {
          "name": "Get User Bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
