        },
        {
          "name": "Create Itinerary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mumbai to Delhi Trip\",\n  \"destination\": \"Delhi\",\n  \"start_date\": \"2024-06-15\",\n  \"end_date\": \"2024-06-20\",\n  \"flight_ids\": \"1,2\",\n  \"hotel_ids\": \"1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/itineraries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "itineraries"]
            }
          }
        }
      ]
    },
