
{
  "info": {
    "name": "SnapTravels API",
    "description": "Complete API collection for SnapTravels booking platform",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "prodUrl",
      "value": "https://snaptravels.online",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "User Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@snaptravels.online\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "signup"]
            }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"parthiban@snaptravels.online\",\n  \"password\": \"Test@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@snaptravels.online\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user"]
            }
          }
        },
        {
          "name": "User Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Flights",
      "item": [
        {
          "name": "Search All Flights",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flights",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights"]
            }
          }
        },
        {
          "name": "Search Flights by Origin",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flights?origin=Mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights"],
              "query": [
                {
                  "key": "origin",
                  "value": "Mumbai"
                }
              ]
            }
          }
        },
        {
          "name": "Search Flights by Destination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flights?destination=Delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights"],
              "query": [
                {
                  "key": "destination",
                  "value": "Delhi"
                }
              ]
            }
          }
        },
        {
          "name": "Search Flights by Route",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flights?origin=Mumbai&destination=Delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights"],
              "query": [
                {
                  "key": "origin",
                  "value": "Mumbai"
                },
                {
                  "key": "destination",
                  "value": "Delhi"
                }
              ]
            }
          }
        },
        {
          "name": "Get Flight Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flights/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Search All Hotels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": ["{{baseUrl}}"],
