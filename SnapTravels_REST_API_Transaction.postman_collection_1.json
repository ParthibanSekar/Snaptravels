{
  "info": {
    "name": "SnapTravels REST API Transaction",
    "description": "3-step API transaction: Login → Search Flights → Create Booking.\nFor Site24x7 REST API Transaction Monitor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://snaptravels.online"
    }
  ],
  "item": [
    {
      "name": "Step 1 — Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"parthiban@snaptravels.online\",\n  \"password\": \"Test@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/mobile-api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["mobile-api", "v1", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.environment.set('token', jsonData.token);",
              "pm.test('Login successful', function() {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(jsonData.token).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Step 2 — Search Flights",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mobile-api/v1/flights/search?origin=Delhi&destination=Mumbai",
          "host": ["{{base_url}}"],
          "path": ["mobile-api", "v1", "flights", "search"],
          "query": [
            {"key": "origin", "value": "Delhi"},
            {"key": "destination", "value": "Mumbai"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Flights returned', function() {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(jsonData.flights).to.be.an('array');",
              "  pm.expect(jsonData.flights.length).to.be.greaterThan(0);",
              "});",
              "if (jsonData.flights && jsonData.flights.length > 0) {",
              "  pm.environment.set('flight_id', jsonData.flights[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Step 3 — Create Booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"FLIGHT\",\n  \"flight_id\": {{flight_id}},\n  \"customer_name\": \"API Monitor Test\",\n  \"customer_email\": \"monitor@snaptravels.online\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/mobile-api/v1/bookings",
          "host": ["{{base_url}}"],
          "path": ["mobile-api", "v1", "bookings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Booking created', function() {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(jsonData.booking).to.not.be.undefined;",
              "  pm.expect(jsonData.booking.booking_code).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
